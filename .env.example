# Moomoo OpenD gateway the sidecar connects to.
# OpenD runs on the host because it needs the interactive desktop login.
OPEND_HOST=host.docker.internal
OPEND_PORT=11111

# Host port used to inspect the sidecar directly (optional).
OPEND_PUBLISH_PORT=18000

LOG_LEVEL=INFO
KAGE_DOCKER_NETWORK=kage-network
